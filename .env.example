NODE_ENV=development
HOST=127.0.0.1
PORT=4300
WEB_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=false
DATABASE_URL=postgres://quality_sphere:change-me@127.0.0.1:5432/quality_sphere
DATABASE_SSL=false
REDIS_URL=redis://127.0.0.1:6379
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30
COOKIE_SECURE=false
CSRF_SECRET=replace-with-at-least-32-random-bytes
PASSWORD_PEPPER=replace-with-at-least-32-random-bytes
OBJECT_STORE_DRIVER=local
LOCAL_OBJECT_ROOT=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=quality-sphere
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_COMMAND=clamscan
OCR_COMMAND=tesseract
LOG_LEVEL=info
OTEL_SERVICE_NAME=quality-sphere-api
OTEL_EXPORTER_OTLP_ENDPOINT=
